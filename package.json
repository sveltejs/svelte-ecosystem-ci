{
  "name": "svelte-ecosystem-ci",
  "private": true,
  "version": "0.0.1",
  "description": "svelte Ecosystem CI",
  "scripts": {
    "prepare": "pnpm exec simple-git-hooks",
    "lint": "eslint '**/*.ts'",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "tsc",
    "format": "prettier --ignore-path .gitignore --check .",
    "format:fix": "pnpm format --write",
    "test:self": "node ecosystem-ci.ts _selftest",
    "test": "node ecosystem-ci.ts",
    "bisect": "node ecosystem-ci.ts bisect"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged --concurrent false"
  },
  "lint-staged": {
    "*": [
      "prettier --write --ignore-unknown"
    ],
    "*.ts": [
      "eslint --fix"
    ]
  },
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.11.1",
      "onFail": "download"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sveltejs/svelte-ecosystem-ci.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sveltejs/svelte-ecosystem-ci/issues"
  },
  "homepage": "https://github.com/sveltejs/svelte-ecosystem-ci#readme",
  "dependencies": {
    "cac": "^6.7.14",
    "execa": "^9.5.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@antfu/ni": "^24.3.0",
    "@eslint/js": "^9.30.1",
    "@types/node": "^22.14.1",
    "eslint": "^9.30.1",
    "eslint-plugin-n": "^17.21.0",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.3",
    "simple-git-hooks": "^2.12.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1"
  }
}
